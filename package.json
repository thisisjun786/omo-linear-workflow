  },
  "pnpm": {
    "onlyBuiltDependencies": ["omo-ai"],
    "patchedDependencies": {
      "@code-yeongyu/senpi@2026.9.22-4": "patches/senpi-mcp-optional-types.patch"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
