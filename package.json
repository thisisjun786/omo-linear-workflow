{
  "name": "omo-initiative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Herdr worktree sessions and event-driven Linear initiative orchestration for OMO",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "cli": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "herdr": "bun scripts/herdr.ts",
    "herdr:build": "bun scripts/build-herdr.ts",
    "qa:herdr": "bun scripts/qa-herdr.ts",
